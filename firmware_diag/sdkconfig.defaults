CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_20M=y
CONFIG_ESPTOOLPY_FLASHFREQ="20m"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# The managed LED-strip/RMT driver has a deeper call chain than the
# diagnostic's default app_main stack.  Keep the probe from turning a
# diagnostic failure into a reset loop.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# This diagnostic tests an SD memory card, not an SDIO I/O device. Skip CMD52.
# CONFIG_SD_ENABLE_SDIO_SUPPORT is not set
